{
    "name": "c-deck-lite",
    "private": false,
    "version": "1.0.3",
    "type": "module",
    "description": "A powerful markdown-based presentation tool with multiple themes, keyboard shortcuts, and PDF export",
    "author": "abudhahir <abudhahir@gmail.com>",
    "license": "MIT",
    "keywords": [
        "markdown",
        "slides",
        "presentation",
        "presenter",
        "react",
        "typescript",
        "slideshow",
        "reveal",
        "deck",
        "markdown-presentation",
        "slide-deck",
        "pdf-export",
        "theme-switcher",
        "keyboard-shortcuts"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/abudhahir/markdown-slide-prese.git"
    },
    "bugs": {
        "url": "https://github.com/abudhahir/markdown-slide-prese/issues"
    },
    "homepage": "https://markdown-slides-abudhahir.github.app",
    "bin": {
        "markdown-slides": "./bin/markdown-slides.js"
    },
    "files": [
        "bin",
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "dev": "vite",
        "kill": "fuser -k 5000/tcp",
        "build": "tsc -b --noCheck && vite build",
        "lint": "eslint .",
        "optimize": "vite optimize",
        "preview": "vite preview",
        "start": "node bin/markdown-slides.js",
        "publish": "bash scripts/publish.sh",
        "prepublishOnly": "npm run build"
    },
